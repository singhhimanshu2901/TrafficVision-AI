# Server Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=3000
PYTHON_BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database & Storage
DATABASE_URL=sqlite:///./trafficvision.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=250
SESSION_RETENTION_DAYS=7

# Computer Vision & YOLOv8n Tracking
MODEL_PATH=./models/yolov8n.pt
MODEL_DEVICE=cpu
CONFIDENCE_THRESHOLD=0.35
INFERENCE_IMAGE_SIZE=416
MAX_STREAM_FPS=15
BYTE_TRACK_MATCH_THRESH=0.8
BYTE_TRACK_TRACK_BUFFER=30
